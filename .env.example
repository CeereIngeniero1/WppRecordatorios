# Configuración de base de datos SQL Server
DB_USER=tu_usuario_sql
DB_PASSWORD=tu_contraseña_sql
DB_SERVER=tu_servidor_sql
DB_NAME=nombre_de_tu_base_de_datos

# Configuración de Correo (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_contraseña_o_token_de_aplicacion
EMAIL_FROM="MEDIMUJER" <tu_correo@gmail.com>

# Configuración de pruebas para Correo
# Si EMAIL_TEST_MODE es true, todos los correos se redirigen a EMAIL_TEST_ADDRESS
EMAIL_TEST_MODE=false
EMAIL_TEST_ADDRESS=correo_de_pruebas@correo.com

# Intervalo de revisión en minutos si la consulta no encuentra citas (ej. 15 o 30)
POLLING_INTERVAL_EMPTY_MINUTES=15

# Timeouts SQL (ms). Por defecto: consulta 120s, conexión 30s
DB_REQUEST_TIMEOUT_MS=120000
DB_CONNECTION_TIMEOUT_MS=30000

# Ritmo de envío (opcional). Si no se definen, el bot elige según el tamaño del lote.
# EMAIL_DELAY_MIN_MS=20000
# EMAIL_DELAY_MAX_MS=40000
